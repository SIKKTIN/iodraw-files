{"root":{"data":{"id":"djtba9lw9nk0","created":1783526235819,"text":"数据存储","priority":null},"children":[{"data":{"id":"djtbbbk1h3s0","created":1783526318425,"text":"目前架构","layout_mind_offset":{"x":62.83333256261187,"y":-143.16666099015225}},"children":[{"data":{"id":"djtbbute5o80","created":1783526360349,"text":"服务器数据->PlayerController"},"children":[]},{"data":{"id":"djtbcnhjnfk0","created":1783526422759,"text":"痛点：PlayerController负责的内容太多太杂，负责RPC大量函数的转接，会有很多的代码干扰，我认为PlayerController应该当作中转站，影响判断，模块化有助于项目的理解"},"children":[]}]},{"data":{"id":"djtbd60e7w00","created":1783526463081,"text":"优化后的架构","layout_mind_offset":{"x":542.3333028670827,"y":118.33332805997827}},"children":[{"data":{"id":"djtbdckxvc80","created":1783526477384,"text":"服务器数据->PlayerPropertyComponent缓存->个体使用","layout_right_offset":{"x":557.4999695395442,"y":-61.66666329734875}},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}